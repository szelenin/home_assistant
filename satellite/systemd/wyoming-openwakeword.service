[Unit]
Description=Wyoming OpenWakeWord Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/satellite
ExecStart=/home/pi/satellite/venv/bin/python -m wyoming_openwakeword \
    --uri tcp://127.0.0.1:10400 \
    --preload-model hey_jarvis \
    --threshold 0.5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
